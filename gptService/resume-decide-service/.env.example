# =============================================================================
# Resume Decider Service Configuration (.env or .env.local)
# Location: gptService/resume-decide-service/.env.local
# =============================================================================
# This service decides the best matching resume from candidate resumes
# for each job description. It is completely isolated from ATS form-filling.
#
# If this file is omitted, it automatically falls back to your root user env
# settings (GEMINI_MODEL, GEMINI_API_KEY_1..N).
# =============================================================================

# LLM Provider: "gemini" or "openai"
RESUME_DECIDE_LLM_PROVIDER=gemini

# Model specifically for evaluating job descriptions and candidate resumes
RESUME_DECIDE_MODEL=gemini-3.5-flash-lite

# Dedicated Gemini API Keys (supports N keys: 1, 2, 3, ...)
# Rotates round-robin and fails over automatically on 429 / 503 limits.
RESUME_DECIDE_GEMINI_API_KEY_1=AIzaSy...
RESUME_DECIDE_GEMINI_API_KEY_2=AIzaSy...
# RESUME_DECIDE_GEMINI_API_KEY_3=AIzaSy...

# Optional OpenAI configuration (for future use if provider is set to "openai")
# RESUME_DECIDE_OPENAI_API_KEY=sk-...
# RESUME_DECIDE_OPENAI_MODEL=gpt-4o-mini
